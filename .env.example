PORT=3000
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
COOKIE_SECURE=true

WA_ALLOWED_NUMBERS=628111111111,628222222222
WA_ALLOWED_GROUPS=120363000000000001@g.us,120363000000000002@g.us

# API key gratis dari https://deepai.org/dashboard/profile (daftar gratis,
# dapat jatah request bulanan gratis). Dipakai untuk .upscale, .animehd, .hapusbg
DEEPAI_API_KEY=your-deepai-api-key

# Opsional: lokasi folder penyimpanan sesi WhatsApp (auth_info).
# - Lokal: boleh dikosongkan (default: ./auth_info di folder project).
# - Railway: buat Volume dengan mount path /data (lihat README bagian
#   "Deploy ke Railway"), bot otomatis pakai /data/auth_info di sana.
#   Isi baris di bawah HANYA jika mau override path defaultnya.
# AUTH_DIR=/data/auth_info
